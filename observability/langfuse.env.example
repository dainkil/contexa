# observability/.env 로 복사해서 값을 채운다. .env는 커밋하지 않는다(.gitignore).
# 아래 openssl 명령으로 만든 값을 넣는다.

# Langfuse 내부 비밀값
LANGFUSE_SALT=                      # openssl rand -hex 16
LANGFUSE_ENCRYPTION_KEY=            # openssl rand -hex 32  (64자)
LANGFUSE_NEXTAUTH_SECRET=           # openssl rand -hex 32

# 처음 띄울 때 만들어지는 로그인 계정 (http://localhost:3000)
LANGFUSE_INIT_USER_EMAIL=you@example.com
LANGFUSE_INIT_USER_PASSWORD=        # 8자 이상

# 처음 띄울 때 만들어지는 프로젝트 API 키. AI 일꾼에도 같은 값을 환경 변수로 넣는다.
LANGFUSE_PUBLIC_KEY=pk-lf-          # pk-lf- 뒤에 openssl rand -hex 16
LANGFUSE_SECRET_KEY=sk-lf-          # sk-lf- 뒤에 openssl rand -hex 16

# 도커 안에서만 쓰는 비밀번호. 비워 두면 compose 파일의 기본값을 쓴다.
# LF_POSTGRES_PASSWORD=
# LF_CLICKHOUSE_PASSWORD=
# LF_MINIO_PASSWORD=
# LF_REDIS_PASSWORD=
